# Copie este arquivo para .env (uso local) e cadastre as mesmas variaveis
# no painel da Vercel (Settings > Environment Variables) ou da Hostinger.
# NUNCA publique o arquivo .env no GitHub.

# Credenciais da conta de servico do Firebase (Admin SDK).
# Firebase Console > Configuracoes do projeto > Contas de servico > Gerar nova chave privada.
FIREBASE_PROJECT_ID=PREENCHER
FIREBASE_CLIENT_EMAIL=PREENCHER@PREENCHER.iam.gserviceaccount.com
# Mantenha as aspas e os \n literais exatamente como estao no arquivo JSON baixado.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPREENCHER\n-----END PRIVATE KEY-----\n"

# Apenas uso local / Hostinger
PORT=3000
